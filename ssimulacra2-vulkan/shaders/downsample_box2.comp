#version 450
// 2x2 box downsample with edge clamp-replication and /4 normalization,
// exact transcription of ssimulacra2.cc:44-66 (accumulation order iy-then-ix,
// multiply by normalize=0.25f last). Input w x h, output ceil(w/2) x ceil(h/2).
layout(local_size_x = 64) in;

layout(push_constant) uniform PC { uint iw; uint ih; uint ow; uint oh; };

layout(set = 0, binding = 0) readonly buffer In { float src[]; };
layout(set = 0, binding = 1) writeonly buffer Out { float dst[]; };

void main() {
  uint i = gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
  if (i >= 3u * ow * oh) { return; }
  uint plane = ow * oh;
  uint c = i / plane;
  uint p = i % plane;
  uint ox = p % ow;
  uint oy = p / ow;
  uint inplane = iw * ih;
  float sum = 0.0;
  for (uint iy = 0; iy < 2u; ++iy) {
    uint y = min(oy * 2u + iy, ih - 1u);
    for (uint ix = 0; ix < 2u; ++ix) {
      uint x = min(ox * 2u + ix, iw - 1u);
      sum += src[c * inplane + y * iw + x];
    }
  }
  dst[i] = sum * 0.25;
}
