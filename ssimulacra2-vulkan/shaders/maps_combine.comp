#version 450
// Per-pixel error maps at one scale, from the 5 blurred images + XYB inputs.
// ssim_d: SSIMMap f32 semantics (ssimulacra2.cc:126-152) - products rounded to
// f32 exactly as the CPU does (precise, ssimulacra2.cc:129-131); the quotient
// is computed in f64 and rounded to f32 (matches the CPU's correctly-rounded
// f32 division to within double-rounding, ~2^-29 of pixels by 1 ulp - the
// GPU's native f32 fdiv was measured 1 ulp off on RDNA2, amplified x225 by
// the large tuned weights).
// edge_d1: EdgeDiffMap ratio in f64 (ssimulacra2.cc:173-175) - the CPU
// computes it in double from f32 inputs; f64 here matches bit-exactly, then
// stores rounded to f32 (norms deviation from storage rounding ~1e-9,
// documented).
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 64) in;

layout(push_constant) uniform PC { uint n; };

layout(set = 0, binding = 0) readonly buffer Img1 { float img1[]; };
layout(set = 0, binding = 1) readonly buffer Img2 { float img2[]; };
layout(set = 0, binding = 2) readonly buffer Mu1 { float mu1[]; };
layout(set = 0, binding = 3) readonly buffer Mu2 { float mu2[]; };
layout(set = 0, binding = 4) readonly buffer S11 { float s11[]; };
layout(set = 0, binding = 5) readonly buffer S22 { float s22[]; };
layout(set = 0, binding = 6) readonly buffer S12 { float s12[]; };
layout(set = 0, binding = 7) writeonly buffer SsimD { float ssimd[]; };
layout(set = 0, binding = 8) writeonly buffer EdgeD1 { float edged[]; };

const float kC2 = 0.0009;

void main() {
  uint i = gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
  if (i >= 3u * n) { return; }
  uint c = i / n;
  uint p = i % n;
  uint b = c * n + p;

  float m1 = mu1[b];
  float m2 = mu2[b];
  // Products computed as float(double*double): exact for f32 inputs, so this
  // is provably the correctly-rounded f32 product on any device (bit-identical
  // to the CPU's mu11/mu22/mu12/dm^2, ssimulacra2.cc:129-131) no matter how
  // the driver contracts mul+sub into fma. Kept after run #14 showed the
  // products were NOT the F4 culprit (llvmpipe output bit-identical with this
  // barrier in) - retained as a device-independent guarantee, value-neutral on
  // IEEE devices (RDNA2 suite unchanged).
  float mu11 = float(double(m1) * double(m1));
  float mu22 = float(double(m2) * double(m2));
  float mu12 = float(double(m1) * double(m2));
  precise float dm = m1 - m2;
  precise float dmsq = float(double(dm) * double(dm));
  precise float num_m = 1.0 - dmsq;
  // F4 final hypothesis (human-deadline round, after #13-#15 refuted
  // products and tree SHAPE as causes): the compiler lowers by SSA PATTERN,
  // not runtime value - num_s's delta+delta (one SSA used twice) matches the
  // x+x -> 2*x -> fma(2,delta,kC2) inexact algebraic rule in Mesa's NIR,
  // while denom_s's d1+d2 (two SSA values) stays plain adds. Runtime-equal
  // inputs, different instruction streams, llvmpipe's non-IEEE fma in one
  // stream => d = 7*2^-24 - consistent with ALL probe data including #14
  // bit-identity (products never fed that fma) and #15 (f64 island got
  // inexact-folded back to the same pattern; A/B regressed via the new
  // f64 round-trip asymmetry). Free disasm check: #13-era decorations sat
  // on the PRODUCT vars only; the add chains NEVER had NoContraction in any
  // version (current count = 0). Fix: precise on every ssim_d-chain result,
  // so glslang decorates delta/num_s/denom_s/prod/num_m/d (verified in
  // disasm) and NIR's inexact rules must not touch those values. This is
  // the last hypothesis-driven round: C clean on llvmpipe => F4 closes and
  // identity gates tighten; otherwise F4 is documented-accepted under the
  // sanity-bar policy and this comment becomes the case file.
  precise float delta = s12[b] - mu12;
  precise float num_s = delta + delta + kC2;
  precise float denom_s = (s11[b] - mu11) + (s22[b] - mu22) + kC2;
  precise float prod = num_m * num_s;
  float q = float(double(prod) / double(denom_s));
  precise float d = 1.0 - q;
  ssimd[b] = max(d, 0.0);

  float t1 = abs(img1[b] - m1);
  float t2 = abs(img2[b] - m2);
  double e1 = 1.0 + double(t1);
  double e2 = 1.0 + double(t2);
  edged[b] = float(e2 / e1 - 1.0);
}
